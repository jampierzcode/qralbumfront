{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://qralbumback-production-6e1d.up.railway.app/api/:path*" },
    { "source": "/media/:path*", "destination": "https://qralbumback-production-6e1d.up.railway.app/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
